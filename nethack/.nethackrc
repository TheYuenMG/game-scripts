#OPTIONS=palette:white-255-255-255



# *** Menu Highlights ***
# Highlight menu lines with different colors. You need to define the colors
# with MENUCOLOR lines.
#
# Toggle menucolor use on or off
OPTIONS=menucolors
#
# Define color used for a certain menu line. Format is
#    MENUCOLOR="regular expression"=color
# or
#    MENUCOLOR="regular expression"=color&attribute
#
# Show gold in yellow
MENUCOLOR="gold piece"=yellow
# Show blessed items in green
MENUCOLOR="( blessed| holy)"=green
# Show cursed items in red (funny aside, the leading space is required
# or else every un"cursed" item also turns red lmao)
MENUCOLOR="( cursed| unholy)"=red
# Show footrice corpses in magenta and inverse
MENUCOLOR="trice"=magenta&inverse
# Show "unbaggables" in cyan and inverse
MENUCOLOR="bag.*(holding|tricks)"=cyan&inverse
MENUCOLOR="wand.*(cancel|vanish)"=cyan&inverse
# Show real Amulet of Yendor in yellow and inverse
MENUCOLOR="Amulet of Yendor named"=yellow&inverse



# *** Status Highlights ***
# One of my favourite sections in the entire config file, this section
# displays coloured text in the status line
#
# Display status highlights for 10 turns
OPTIONS=statushilites:10
#
# Display hitpoint bar at name and title
OPTIONS=hitpointbar
#
# Highlight hitpoints at certain thresholds
OPTIONS=hilite_status:hitpoints/100%/white&normal
OPTIONS=hilite_status:hitpoints/<100%/green&normal
OPTIONS=hilite_status:hitpoints/<75%/yellow&normal
OPTIONS=hilite_status:hitpoints/<50%/orange&bold
OPTIONS=hilite_status:hitpoints/<25%/red&bold
OPTIONS=hilite_status:hitpoints/<10%/red&bold&inverse
#
# Highlight power at certain thresholds
OPTIONS=hilite_status:power/100%/white&normal
OPTIONS=hilite_status:power/<100%/cyan&normal
OPTIONS=hilite_status:power/<75%/brightblue&normal
OPTIONS=hilite_status:power/<50%/blue&normal
OPTIONS=hilite_status:power/<25%/gray&normal
#
# Highlight encumberance at each stage
OPTIONS=hilite_status:cap/burdened/yellow
OPTIONS=hilite_status:cap/stressed/orange
OPTIONS=hilite_status:cap/strained/red&bold
OPTIONS=hilite_status:cap/overtaxed/red&inverse
OPTIONS=hilite_status:cap/overloaded/red&inverse&blink
#
# Highlight hunger at each stage
OPTIONS=hilite_status:hunger/satiated/brightmagenta&bold
OPTIONS=hilite_status:hunger/hungry/yellow
OPTIONS=hilite_status:hunger/weak/orange&bold
OPTIONS=hilite_status:hunger/fainting/red&bold
OPTIONS=hilite_status:hunger/fainted/red&inverse&blink
#
# Highlight non-lethal status effects
OPTIONS=hilite_status:condition/hallu/yellow&bold
OPTIONS=hilite_status:condition/conf/brightmagenta&bold
OPTIONS=hilite_status:condition/stun/brightblue&bold
#
# Highlight lethal status effects
OPTIONS=hilite_status:condition/termill/gray&bold&inverse
OPTIONS=hilite_status:condition/foodpois/brightmagenta&bold&inverse
OPTIONS=hilite_status:condition/slime/brightgreen&bold&inverse
#
# Highlight gold at increase or decrease
OPTIONS=hilite_status:gold/up/yellow/down/red
#
# Highlight attributes at increase or decrease
OPTIONS=hilite_status:characteristics/up/green/down/red



# *** Extra Options ***
# Collection of options outside of the above categories to reduce my suffering
#
# Dig automatically when moving while wielding a digging tool
OPTIONS=autodig
# Disable generation of bones files
OPTIONS=!bones
# Default to "yes" and "ask" when disclosing post-game information
OPTIONS=disclose:yi ya ?v yg yc yo
# Highlight allied creatures to distinguish from non-tame creatures
OPTIONS=hilite_pet
# Highlight tiles with multiple items
OPTIONS=hilite_pile
# Label items confirmed to be uncursed explicitly with "uncursed"
OPTIONS=!implicit_uncursed
# Exchange current weapon to alternate weapon slot when wielding second weapon
OPTIONS=pushweapon
# Redraw screen after every turn for multi-turn actions
OPTIONS=runmode:walk
# Enable quick movement with travel command
OPTIONS=travel
# Hide certain frequent and annoying messages
MSGTYPE=hide "With (great|little) effort, you move the boulder."
MSGTYPE=hide "You swap places with .*"
# Stop and prompt --More-- at certain significant messages
MSGTYPE=stop "You feel a strange vibration .*"
MSGTYPE=stop "You wrest .*"
# Map glyphs to non-default symbols
SYMBOLS=S_boulder:0
SYMBOLS=S_ghost:X
SYMBOLS=S_lava:~
SYMBOLS=S_mimic_def:m
SYMBOLS=S_poisoncloud:~
SYMBOLS=S_pool:~
SYMBOLS=S_strange_obj:m
SYMBOLS=S_water:~



# "So be it, until the Amulet of Yendor is mine and there is no Moloch, but ascension!"
# - Dungeon Crawler's Creed
